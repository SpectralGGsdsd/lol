
local RunService = game:GetService("RunService")
local InputService = game:GetService("UserInputService")

local UI = {
    Objects = {},
    Connections = {},
    Window = {},
    Visible = true
}

local mouse = game:GetService("Players").LocalPlayer:GetMouse()

local function createWindow(name)
    local title = Drawing.new("Text")
    title.Text = name
    title.Size = 20
    title.Color = Color3.fromRGB(255,255,255)
    title.Position = Vector2.new(100, 100)
    title.Center = false
    title.Outline = true

    local bg = Drawing.new("Square")
    bg.Size = Vector2.new(400, 300)
    bg.Position = Vector2.new(100, 120)
    bg.Color = Color3.fromRGB(30, 30, 30)
    bg.Filled = true
    bg.Transparency = 0.9

    local dragging = false
    local dragOffset = Vector2.new()

    InputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if mouse.X > bg.Position.X and mouse.X < bg.Position.X + bg.Size.X and
               mouse.Y > bg.Position.Y and mouse.Y < bg.Position.Y + 25 then
                dragging = true
                dragOffset = Vector2.new(mouse.X, mouse.Y) - bg.Position
            end
        end
    end)

    InputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging then
            local newPos = Vector2.new(mouse.X, mouse.Y) - dragOffset
            bg.Position = newPos
            title.Position = newPos - Vector2.new(0, 20)
        end
    end)

    UI.Window.Title = title
    UI.Window.BG = bg
end

-- ✅ Toggle checkbox
local function createToggle(label, callback, yOffset)
    local box = Drawing.new("Square")
    box.Size = Vector2.new(15, 15)
    box.Position = UI.Window.BG.Position + Vector2.new(10, yOffset)
    box.Color = Color3.fromRGB(60, 60, 60)
    box.Filled = true

    local txt = Drawing.new("Text")
    txt.Text = label
    txt.Size = 15
    txt.Position = box.Position + Vector2.new(20, -2)
    txt.Color = Color3.fromRGB(255, 255, 255)

    local state = false

    InputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if mouse.X >= box.Position.X and mouse.X <= box.Position.X + box.Size.X and
               mouse.Y >= box.Position.Y and mouse.Y <= box.Position.Y + box.Size.Y then
                state = not state
                box.Color = state and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 60)
                callback(state)
            end
        end
    end)
end

-- 📉 Slider
local function createSlider(label, min, max, default, callback, yOffset)
    local bar = Drawing.new("Square")
    bar.Size = Vector2.new(200, 5)
    bar.Position = UI.Window.BG.Position + Vector2.new(10, yOffset)
    bar.Color = Color3.fromRGB(100, 100, 100)
    bar.Filled = true

    local fill = Drawing.new("Square")
    fill.Size = Vector2.new((default - min)/(max - min) * bar.Size.X, 5)
    fill.Position = bar.Position
    fill.Color = Color3.fromRGB(0, 150, 255)
    fill.Filled = true

    local txt = Drawing.new("Text")
    txt.Text = label .. ": " .. tostring(default)
    txt.Size = 15
    txt.Position = bar.Position + Vector2.new(0, -18)
    txt.Color = Color3.fromRGB(255, 255, 255)

    InputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if mouse.X >= bar.Position.X and mouse.X <= bar.Position.X + bar.Size.X and
               mouse.Y >= bar.Position.Y and mouse.Y <= bar.Position.Y + bar.Size.Y then
                local conn
                conn = RunService.RenderStepped:Connect(function()
                    if not InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        conn:Disconnect()
                    end
                    local mouseX = math.clamp(mouse.X, bar.Position.X, bar.Position.X + bar.Size.X)
                    local ratio = (mouseX - bar.Position.X) / bar.Size.X
                    local val = math.floor((min + (max - min) * ratio) * 10) / 10
                    fill.Size = Vector2.new(bar.Size.X * ratio, 5)
                    txt.Text = label .. ": " .. tostring(val)
                    callback(val)
                end)
            end
        end
    end)
end

-- 🧩 Dropdown
local function createDropdown(label, options, default, callback, yOffset)
    local current = default
    local txt = Drawing.new("Text")
    txt.Text = label .. ": " .. default
    txt.Size = 15
    txt.Position = UI.Window.BG.Position + Vector2.new(10, yOffset)
    txt.Color = Color3.fromRGB(255, 255, 255)

    InputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if mouse.X >= txt.Position.X and mouse.X <= txt.Position.X + 200 and
               mouse.Y >= txt.Position.Y and mouse.Y <= txt.Position.Y + 20 then
                local nextIndex = table.find(options, current) + 1
                if nextIndex > #options then nextIndex = 1 end
                current = options[nextIndex]
                txt.Text = label .. ": " .. current
                callback(current)
            end
        end
    end)
end

RunService.RenderStepped:Connect(function()
    UI.Window.Title.Visible = UI.Visible
    UI.Window.BG.Visible = UI.Visible
end)
